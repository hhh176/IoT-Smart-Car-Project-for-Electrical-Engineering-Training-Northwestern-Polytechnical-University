  25          uchar Read_IAP(uint Adres)
  26          {
  27   1       uchar  Value;
  28   1       IAP_CONTR = ENABLE_IAP;     //打开IAP功能
  29   1       IAP_CMD = ISP_IAP_BYTE_READ;//读IAP
  30   1       IAP_ADDRH = Adres >> 8;     //取高位地址
  31   1       IAP_ADDRL = Adres &0x00FF;  //取低位地址
  32   1       EA = 0;                     //关中断
  33   1       IAP_TRIG = 0x5a;            //触发寄存器
  34   1       IAP_TRIG = 0xa5;            //IAP触发启动
  35   1       _nop_();
  36   1       Value = IAP_DATA;       //读取字节数据
  37   1       EA = 1;
  38   1       Disable_IAP();          //关闭IAP功能
  39   1       return Value;
  40   1      }

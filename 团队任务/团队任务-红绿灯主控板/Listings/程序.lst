  61          
  62          void Speech(uchar *buf)
  63          {
  64   1          uchar i = 0, xor = 0x00, ch = 0x00, len = 0x00;
  65   1          while(buf[len++]);
  66   1          len--; 
  67   1          for(i = 0; i < HEADLEN; i++)
  68   1          {
  69   2              if(i == BKM_OFFSET) ch = nBkm << 3; 
  70   2              else if(i == LEN_OFFSET) ch = len + 3;
  71   2              else ch = head[i];
  72   2              xor ^= ch;
  73   2              while (busy); busy = 1; S4BUF = ch; 
  74   2          }
  75   1          for(i = 0; i < len; i++)
  76   1          {
  77   2              xor ^= buf[i];
  78   2              while (busy); busy = 1; S4BUF = buf[i];
  79   2          }
  80   1          while (busy); busy = 1; S4BUF = xor;         
  81   1          
  82   1          delayms(10); 
  83   1      }

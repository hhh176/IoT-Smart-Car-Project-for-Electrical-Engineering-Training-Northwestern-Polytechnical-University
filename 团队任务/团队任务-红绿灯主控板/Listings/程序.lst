 220          // 定时器0中断：驱动舵机输出，并提供系统心跳基准
 221          void Timer0_isr() interrupt 1 
 222          {
 223   1          static uint i = 1;            
 224   1          switch(i)
 225   1          {
 226   2              case 1: PWM1 = 1; Timer0(Servo1PwmDat); break;      
 227   2              case 2: PWM1 = 0; Timer0(20000-Servo1PwmDat); i = 0; break;   
 228   2          }
 229   1          i++;
 230   1      

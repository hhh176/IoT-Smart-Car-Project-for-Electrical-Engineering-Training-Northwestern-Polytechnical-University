 165   1          for(i = 0; i < HEADLEN; i++)
 166   1          {
 167   2              if(i == BKM_OFFSET)
 168   2                  ch = nBkm << 3;
 169   2              else if(i == LEN_OFFSET)
 170   2                  ch = len + 3;
 171   2              else
 172   2                  ch = head[i];
 173   2              speechBuf[i] = ch;
 174   2              xor ^= ch;
 175   2          }
 176   1          for(i = 0; i < len; i++)
 177   1          {
 178   2              speechBuf[HEADLEN + i] = buf[i];

 179   2              xor ^= buf[i];
 180   2          }
 181   1          speechBuf[HEADLEN + len] = xor;
 182   1          speechLen = HEADLEN + len + 1;
 183   1          speechPos = 0;
 184   1          speechSending = 1;
 185   1          if(!busy && speechPos < speechLen)
 186   1          {
 187   2              busy = 1;
 188   2              S4BUF = speechBuf[speechPos++];

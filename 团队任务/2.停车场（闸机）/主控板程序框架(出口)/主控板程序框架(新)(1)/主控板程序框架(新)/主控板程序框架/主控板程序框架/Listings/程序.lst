 157          void Speech_Start(uchar *buf)
 158          {
 159   1          uchar i = 0;
 160   1          uchar xor = 0x00;
 161   1          uchar ch = 0x00;
 162   1          uchar len = 0x00;
 163   1          while(buf[len++]);

 118          /* ======================================================== */
 119          /*             语音播放函数                                    */
 120          /* ======================================================== */
 121          void Speech(uchar *buf)
 122          {
 123   1           uchar i = 0;
 124   1           uchar xor = 0x00;
 125   1           uchar ch = 0x00;
 126   1         uchar len = 0x00;
 127   1         while(buf[len++]);
 128   1        for(i = 0; i < HEADLEN; i++)
 129   1            {
 130   2                if(i == BKM_OFFSET)
 131   2                ch = nBkm << 3;
 132   2                else if(i == LEN_OFFSET)
 133   2                ch = len + 3;
 134   2                else
 135   2                ch = head[i];
 136   2                xor ^= ch;
 137   2                Uart4Send(ch);
 138   2          }
 139   1          for(i = 0; i < len; i++)
 140   1          {
 141   2              xor ^= buf[i];
 142   2              Uart4Send(buf[i]);
 143   2          }
 144   1          Uart4Send(xor);
 145   1         delayms(20);
 146   1         while(BUSY);
 147   1         delayms(20);
 148   1      }

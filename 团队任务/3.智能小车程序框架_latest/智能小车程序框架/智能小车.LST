 388          /////////////////////////////////////////////////外部中断T0超声波接收计算距离
 389          void INT0_Isr() interrupt 0
 390          {
 391   1         EX0 = 0;                                     //关闭外部中断T0
 392   1         TR0 = 0;                                     //停止定时T0工作
 393   1         S = TH0*256+TL0;                             //把超声返回时间放到S里

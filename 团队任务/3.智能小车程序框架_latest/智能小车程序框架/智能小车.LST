 244          //////////////////////////////////语音播报程序 
 245          void Speech(uchar *buf)
 246          {
 247   1         uchar i = 0;          //循环计数变量
 248   1         uchar xor = 0x00;     //校验码初始化
 249   1         uchar ch = 0x00;
 250   1         uchar len = 0x00;
 251   1         while(buf[len++]);
 252   1        //发送数据包头(0xFD + 2字节长度 + 1字节命令字 + 1字节命令参数)
 253   1        for(i = 0; i < HEADLEN; i++)
 254   1          {
 255   2            if(i == BKM_OFFSET)
 256   2            ch = nBkm << 3; //写入背景音乐
 257   2            else if(i == LEN_OFFSET)
 258   2            ch = len + 3;
 259   2            else
 260   2            ch = head[i];
 261   2            xor ^= ch;
 262   2            Uart3Send(ch);
 263   2          }
 264   1        //发送文字内容
 265   1        for(i = 0; i < len; i++)
 266   1        {
 267   2          xor ^= buf[i];
 268   2          Uart3Send(buf[i]);
 269   2        }
 270   1          Uart3Send(xor);         //发送校验位
 271   1          delayms(50);
 272   1          while(BUSY);            //等待语音播报完成
 273   1            delayms(50);
 274   1      }

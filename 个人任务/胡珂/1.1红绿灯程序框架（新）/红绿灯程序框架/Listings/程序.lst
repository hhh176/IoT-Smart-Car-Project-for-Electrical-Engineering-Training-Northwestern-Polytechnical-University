 153          //////////////////////////////////处理串口接收到的命令
 154          // 命令协议（共两种）：
 155          //   PC串口命令：0xA1(地址) 绿灯值 黄灯值 红灯值 0xDD(结束符)
 156          //   无线调度台命令：0xA5 命令码 数据1 数据2 0xDD
 157          //     命令码 0x01 = K1按下 → 日间模式（数据1=绿灯时长，数据2=红灯时长）
 158          //     命令码 0x02 = K2按下 → 夜间模式
 159          void process_cmd()
 160          {
 161   1        uchar i;
 162   1        
 163   1        if(pc_dat[4] != 0xDD) return;    //未收到完整命令则退出
 164   1        
 165   1        // PC串口命令（设置各灯时长并强制日间模式）
 166   1        if(pc_dat[0] == 0xA1)
 167   1        {
 168   2          gsec = pc_dat[1];             //更新绿灯秒数
 169   2          ysec = pc_dat[2];             //更新黄灯秒数
 170   2          rsec = pc_dat[3];             //更新红灯秒数
 171   2          enter_day_mode();             //恢复日间正常循环
 172   2        }
 173   1        // 无线调度台命令
 174   1        else if(pc_dat[0] == 0xA5)
 175   1        {
 176   2          switch(pc_dat[1])
 177   2          {
 178   3            case 0x01:                //K1：日间模式，携带红绿灯时长
C51 COMPILER V9.60.0.0   ____                                                              05/22/2026 09:45:27 PAGE 4   

 179   3              gsec = pc_dat[2];     //绿灯时长
 180   3              rsec = pc_dat[3];     //红灯时长
 181   3              enter_day_mode();
 182   3              break;
 183   3              
 184   3            case 0x02:                //K2：夜间模式
 185   3              enter_night_mode();
 186   3              break;
 187   3          }
 188   2        }
 189   1        
 190   1        // 清除命令缓冲，准备接收下一条
 191   1        for(i=0;i<5;i++) pc_dat[i] = 0;
 192   1      }

 119          //////////////////////////////////交通灯状态切换（日间模式用）
 120          void change_state()
 121          {
 122   1        switch(state)
 123   1        {
 124   2          case STATE_GREEN:             //绿灯结束→切换到黄灯
 125   2            state = STATE_YELLOW;
 126   2            sec = ysec;               //加载黄灯倒计时（3s）

 254          //////////////////////////////////////////////定时器T0中断处理（10ms一次）
 255          void Timer0_isr() interrupt 1 
 256          {
 257   1        static uchar t100 = 0;            //1秒计数器（100×10ms=1s）
 258   1        static uchar t50  = 0;            //0.5秒计数器（50×10ms=0.5s）
 259   1        
 260   1        t100++;
 261   1        t50++;
 262   1        
 263   1        if(t100 == 100)                   //每10ms中断一次，10ms*100=1s
 264   1        {
 265   2          t100 = 0;                     //清零1秒计数
 266   2          flag = 1;                     //置位1秒标志
 267   2          
 268   2          if(!night_mode && sec > 0)    //日间模式且未到0
 269   2            sec--;                    //倒计时减1
 270   2        }
 271   1        
 272   1        if(t50 == 50)                     //50×10ms=0.5s
 273   1        {
 274   2          t50 = 0;                      //清零0.5秒计数
 275   2          half_flag = 1;                //置位0.5秒标志
 276   2        }
 277   1      }

 128   2            YY = 0;                   //开黄灯（低电平点亮）
 129   2            RR = 1;                   //关红灯
 130   2            yel_on = 1;               //黄灯初始为亮
 131   2            break;
 132   2            
 133   2          case STATE_YELLOW:            //黄灯结束→切换到红灯
 134   2            state = STATE_RED;
 135   2            sec = rsec;               //加载红灯倒计时（12s）
 136   2            GG = 1;
 137   2            YY = 1;                   //关黄灯
 138   2            RR = 0;                   //开红灯
 139   2            yel_on = 0;
 140   2            break;
 141   2            
 142   2          case STATE_RED:               //红灯结束→切换到绿灯
 143   2            state = STATE_GREEN;
 144   2            sec = gsec;               //加载绿灯倒计时（10s）
 145   2            GG = 0;                   //开绿灯
 146   2            YY = 1;
 147   2            RR = 1;                   //关红灯
 148   2            yel_on = 0;

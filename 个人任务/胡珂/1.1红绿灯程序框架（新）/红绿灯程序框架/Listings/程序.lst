 279          ///////////////////////////////////////////串口接收中断（接收PC/无线模块发来的十六进制指令）
 280          void Uart_1() interrupt 4
 281          {  
 282   1        if(RI)                       //等待接收指令是否接收完，接收完RI就置1
 283   1        {           
 284   2          RI = 0;                    //软件清零RI标志
 285   2          pc_dat[sum] = SBUF;          //将串口通信模块发来的指令存到pc_dat[]数组
 286   2          
 287   2          // 收到结束符0xDD时重置sum，为下次接收准备
 288   2          if(pc_dat[sum] == 0xDD)
 289   2          {
 290   3            sum = 0;                 //归零，等待主循环处理
 291   3          }
 292   2          else
 293   2          {
 294   3            sum++;
 295   3            if(sum >= 10) sum = 0;   //防止数组越界
 296   3          }
 297   2        } 
 298   1      }



  84          void Speech(uchar *buf)
  85          {
  86   1           uchar i = 0;          //循环计数变量
  87   1           uchar xor = 0x00;     //校验码初始化
  88   1           uchar ch = 0x00;
  89   1         uchar len = 0x00;
  90   1         while(buf[len++]);
  91   1          //发送数据包头(0xFD + 2字节长度 + 1字节命令字 + 1字节命令参数)
  92   1        for(i = 0; i < HEADLEN; i++)
  93   1            {
  94   2                if(i == BKM_OFFSET)
  95   2                ch = nBkm << 3; //写入背景音乐
  96   2                else if(i == LEN_OFFSET)
  97   2                ch = len + 3;
  98   2                else
  99   2                ch = head[i];
 100   2                xor ^= ch;
 101   2                Uart4Send(ch);
 102   2          }
 103   1          //发送文字内容
 104   1          for(i = 0; i < len; i++)
 105   1          {
 106   2              xor ^= buf[i];
 107   2              Uart4Send(buf[i]);
 108   2          }
 109   1          Uart4Send(xor);         //发送校验位
 110   1         delayms(20);
 111   1         while(BUSY);            //等待语音播报完成（保留兼容阻塞接口）
 112   1         delayms(20);
 113   1      }

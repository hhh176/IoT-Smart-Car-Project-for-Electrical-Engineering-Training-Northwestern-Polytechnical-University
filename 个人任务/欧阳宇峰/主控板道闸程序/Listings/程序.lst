 280          //////////////////////////////////////////////定时器T0中断处理舵机
 281          void Timer0_isr() interrupt 1 
 282          {
 283   1         static uint i = 1;            //静态变量：每次调用函数时保持上一次所赋的值    
 284   1         switch(i)
 285   1           {
 286   2              case 1: PWM1 = 1;           //PWM1控制舵机脚高电平输出                
 287   2              Timer0(Servo1PwmDat); break;//给定时器0赋值，计数Pwm1Dat个脉冲后产生中断，下次中断会进入下一个case
             -语句      
 288   2                case 2: PWM1 = 0;           //PWM控制舵机脚低电平               
 289   2              Timer0(20000-Servo1PwmDat); i = 0; break;   
 290   2      //高脉冲结束后剩下的时间(20000-Pwm1Dat)全是低电平了，Pwm1Dat + (20000-Pwm1Dat) = 20000个脉冲正好为一个周期
             -20毫秒                                            
 291   2           }
 292   1         i++;
 293   1      }   

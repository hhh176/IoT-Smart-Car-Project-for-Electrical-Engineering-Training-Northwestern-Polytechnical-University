 122          void Speech_Start(uchar *buf)
 123          {
 124   1          uchar i = 0;
 125   1          uchar xor = 0x00;
 126   1          uchar ch = 0x00;
 127   1          uchar len = 0x00;
 128   1          // 计算字符串长度（与同步函数一致的方式）
 129   1          while(buf[len++]);
 130   1          // 构造包头和内容到 speechBuf
 131   1          if(len + HEADLEN + 1 > SPEECH_BUF_SIZE) return; //超长则放弃
 132   1          for(i = 0; i < HEADLEN; i++)
 133   1          {
 134   2              if(i == BKM_OFFSET)
 135   2                  ch = nBkm << 3;
 136   2              else if(i == LEN_OFFSET)
 137   2                  ch = len + 3;
 138   2              else
 139   2                  ch = head[i];
 140   2              speechBuf[i] = ch;
 141   2              xor ^= ch;
 142   2          }
 143   1          // 复制文字内容
 144   1          for(i = 0; i < len; i++)
 145   1          {
 146   2              speechBuf[HEADLEN + i] = buf[i];
 147   2              xor ^= buf[i];
 148   2          }
 149   1          speechBuf[HEADLEN + len] = xor; //校验位
 150   1          speechLen = HEADLEN + len + 1;
 151   1          speechPos = 0;
 152   1          speechSending = 1;
 153   1          // 如果当前总线空闲，先发第一个字节，否则ISR会继续发送
 154   1          if(!busy && speechPos < speechLen)
 155   1          {
 156   2              busy = 1;
 157   2              S4BUF = speechBuf[speechPos++];
 158   2          }
 159   1      }

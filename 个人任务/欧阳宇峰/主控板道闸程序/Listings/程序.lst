 161          void Timer0(uint pwm)           //11.0592Mhz晶振，12分频，所以计数器每递增一个数就是接近1微秒，
 162          {
 163   1         uint value;
 164   1         value=65535-pwm;       
 165   1         TR0 = 0;                     //关闭定时器T0
 166   1         TL0=value;                   //16位数据给8位数据赋值默认将16位数据的低八位直接赋给八位数据
 167   1         TH0=value>>8;                //将16位数据右移8位，也就是将高8位移到低八位，再赋值给8位数据       
 168   1         TR0 = 1;                     //启动定时器T0
 169   1      }
